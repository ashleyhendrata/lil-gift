rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The room code is the shared secret: long and unguessable, and rooms can't be listed.
    match /rooms/{room}/gifts/{gift} {
      allow read: if request.auth != null && room.size() >= 12;
      allow create: if request.auth != null
        && room.size() >= 12
        && request.resource.data.keys().hasOnly(['scene', 'createdAt'])
        && request.resource.data.scene is string
        && request.resource.data.scene.size() < 20000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
